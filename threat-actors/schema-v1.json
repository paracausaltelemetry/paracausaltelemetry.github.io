{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paracausaltelemetry.com/threat-actors/schema-v1.json",
  "title": "Paracausal Telemetry Threat Actor Profile v1",
  "description": "Authoring contract for source-resolved, review-dated threat actor dossiers.",
  "type": "object",
  "required": [
    "schemaVersion", "id", "slug", "name", "summary", "distribution", "status",
    "actorType", "primaryFocus", "lastReviewed", "overallConfidence", "stateAffiliation",
    "observedSince", "designations", "assessment", "targets", "campaigns", "capabilities",
    "malware", "ttps", "indicatorNotice", "indicators", "defensivePriorities", "sources"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^actor-[a-z0-9-]+$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "distribution": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "minLength": 1 },
    "actorType": { "type": "string", "minLength": 1 },
    "primaryFocus": { "type": "string", "minLength": 1 },
    "lastReviewed": { "$ref": "#/$defs/date" },
    "overallConfidence": { "$ref": "#/$defs/confidence" },
    "stateAffiliation": {
      "type": "object",
      "required": ["state", "assessment", "confidence", "sourceIds"],
      "properties": {
        "state": { "type": "string", "minLength": 1 },
        "assessment": { "type": "string", "minLength": 1 },
        "confidence": { "$ref": "#/$defs/confidence" },
        "sourceIds": { "$ref": "#/$defs/sourceIds" }
      }
    },
    "observedSince": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourcedClaim" } },
    "designations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/sourcedClaim" },
          {
            "type": "object",
            "required": ["provider", "name", "relationship", "confidence"],
            "properties": {
              "provider": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 },
              "externalId": { "type": "string" },
              "relationship": { "$ref": "#/$defs/relationship" },
              "confidence": { "$ref": "#/$defs/confidence" }
            }
          }
        ]
      }
    },
    "assessment": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourcedClaim" } },
    "targets": {
      "type": "object",
      "required": ["regions", "sectors", "technologies"],
      "properties": {
        "regions": { "$ref": "#/$defs/claimArray" },
        "sectors": { "$ref": "#/$defs/claimArray" },
        "technologies": { "$ref": "#/$defs/claimArray" }
      }
    },
    "campaigns": { "$ref": "#/$defs/claimArray" },
    "capabilities": { "$ref": "#/$defs/claimArray" },
    "malware": { "$ref": "#/$defs/claimArray" },
    "ttps": {
      "type": "object",
      "required": ["enterprise", "ics"],
      "propertyNames": { "$ref": "#/$defs/attackDomain" },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "allOf": [
            { "$ref": "#/$defs/sourcedClaim" },
            {
              "type": "object",
              "required": ["id", "name", "tactic", "scope", "confidence"],
              "properties": {
                "id": { "type": "string", "pattern": "^T[0-9]{4}(?:\\.[0-9]{3})?$" },
                "name": { "type": "string", "minLength": 1 },
                "tactic": { "type": "string", "minLength": 1 },
                "scope": { "type": "string", "minLength": 1 },
                "confidence": { "$ref": "#/$defs/confidence" }
              }
            }
          ]
        }
      }
    },
    "indicatorNotice": { "type": "string", "minLength": 1 },
    "indicators": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "#/$defs/sourcedClaim" },
          {
            "type": "object",
            "required": ["type", "value", "reported", "status"],
            "properties": {
              "type": { "$ref": "#/$defs/indicatorType" },
              "value": { "type": "string", "minLength": 1 },
              "reported": { "$ref": "#/$defs/date" },
              "status": { "$ref": "#/$defs/indicatorStatus" }
            }
          }
        ]
      }
    },
    "defensivePriorities": { "$ref": "#/$defs/claimArray" },
    "sources": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "publisher", "title", "url", "published", "type"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "publisher": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "published": { "$ref": "#/$defs/date" },
          "updated": { "$ref": "#/$defs/date" },
          "type": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "date": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
    "relationship": { "type": "string", "enum": ["canonical", "overlap", "associated"] },
    "attackDomain": { "type": "string", "enum": ["enterprise", "ics"] },
    "indicatorType": { "type": "string", "enum": ["ipv4", "domain", "sha256", "path", "url"] },
    "indicatorStatus": { "type": "string", "enum": ["current", "historical", "revoked"] },
    "sourceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "sourcedClaim": {
      "type": "object",
      "required": ["sourceIds"],
      "properties": { "sourceIds": { "$ref": "#/$defs/sourceIds" } }
    },
    "claimArray": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourcedClaim" } }
  }
}
